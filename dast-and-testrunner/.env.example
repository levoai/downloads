# Copy to .env and fill in. Never commit the real .env.
# Plain KEY=value lines, no quotes, UTF-8 without a BOM.

# --- Required ---------------------------------------------------------------
LEVOAI_AUTH_KEY=
LEVOAI_ORG_ID=

# --- Region -----------------------------------------------------------------
# India: https://api.india-1.levo.ai
LEVOAI_BASE_URL=https://api.levo.ai

# --- What to run ------------------------------------------------------------
# dast, api-testing and scheduled are the available profiles.
COMPOSE_PROFILES=dast,api-testing
DAST_REPLICAS=2
DAST_SCHEDULED_REPLICAS=1
TESTRUNNER_REPLICAS=1

# --- Groups (leave empty for no group) --------------------------------------
# The DAST worker uses its group exactly as typed (case-sensitive). The test
# runner lowercases its group and turns punctuation into "_". Use lowercase
# letters, digits and "_" so both runners see the same name.
DAST_GROUP=
TESTRUNNER_GROUP=

# --- Images -----------------------------------------------------------------
DAST_IMAGE_TAG=stable
TESTRUNNER_IMAGE_TAG=stable

# --- Optional ---------------------------------------------------------------
# Set when the worker cannot work out the workspace on its own.
LEVOAI_WORKSPACE_ID=
# Per DAST replica. Each one is a headless Chromium.
DAST_MEMORY_LIMIT=2g
DAST_CPU_LIMIT=2
