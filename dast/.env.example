# Copy to .env and fill in. Never commit the real .env.
# Plain KEY=value lines, no quotes, UTF-8 without a BOM.

# --- Required ---------------------------------------------------------------
LEVOAI_AUTH_KEY=
LEVOAI_ORG_ID=

# --- Region -----------------------------------------------------------------
# India: https://api.india-1.levo.ai
LEVOAI_BASE_URL=https://api.levo.ai

# --- What to run ------------------------------------------------------------
# dast, api-testing, scheduled and api-testing-scheduled are the available profiles.
COMPOSE_PROFILES=dast,api-testing
DAST_REPLICAS=2
DAST_SCHEDULED_REPLICAS=1
TESTRUNNER_REPLICAS=1
TESTRUNNER_SCHEDULED_REPLICAS=0

# --- Groups (leave empty for no group) --------------------------------------
# The DAST worker uses its group exactly as typed (case-sensitive). The test
# runner lowercases its group and turns punctuation into "_". Use lowercase
# letters, digits and "_" so both runners see the same name.
DAST_GROUP=
TESTRUNNER_GROUP=

# --- Images -----------------------------------------------------------------
DAST_IMAGE_TAG=stable
TESTRUNNER_IMAGE_TAG=stable

# --- Optional ---------------------------------------------------------------
# Set when the worker cannot work out the workspace on its own.
LEVOAI_WORKSPACE_ID=
# Per DAST replica. Each one is a headless Chromium.
DAST_MEMORY_LIMIT=2g
DAST_CPU_LIMIT=2
# Per test runner replica (on-demand and scheduled).
TESTRUNNER_MEMORY_LIMIT=1g
TESTRUNNER_CPU_LIMIT=1

# --- Custom CA and client certificates (DAST workers) ------------------------
# Put the files in ./certs next to docker-compose.yml, then point these at them
# under /etc/shadownet/certs. Leave a line out to leave the setting off.
# CA the worker trusts for Levo, Temporal and the browser (internal CA, TLS-inspecting proxy):
#LEVOAI_CA_CERT=/etc/shadownet/certs/ca.pem
# A different or extra CA for the target application only:
#CA_CERT_PATH=/etc/shadownet/certs/target-ca.pem
# Client certificate presented to the target application (mutual TLS); both are required together:
#CLIENT_CERT_PATH=/etc/shadownet/certs/client.crt
#CLIENT_KEY_PATH=/etc/shadownet/certs/client.key
# Temporal-only CA and SNI override, when Temporal sits behind an ingress with another hostname:
#LEVOAI_TEMPORAL_CA_CERT=/etc/shadownet/certs/temporal-ca.pem
#LEVOAI_TEMPORAL_TLS_SERVER_NAME=
# false turns off certificate checks for the Levo and Temporal connections only. Avoid it.
#VERIFY_SSL=true
